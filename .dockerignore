# Demos Network Node - Docker ignore file

# Node modules (will be installed in container)
node_modules/
bun.lockb

# Git
.git/
.gitignore

# Data directories (mounted as volumes)
docker_data/
data/
logs/
postgres/
postgres_*/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Environment files (mounted separately)
.env
.env.local
.env.*.local

# Runtime files
*.log
*.pid
*.seed
*.pid.lock

# Coverage and test files
coverage/
.nyc_output
.jest/

# Build files
dist/
build/
*.tgz

# Backup files
*.backup
backup/
backups/

# Identity and sensitive files (mounted as volumes)
.demos_identity
public.key
private.key
*.pem

# Peer lists (mounted as volumes)
demos_peerlist.json
peer_*.json

# Documentation (not needed in container)
docs/
documentation/
README.md
*.md

# Docker files (not needed inside container)
Dockerfile*
docker-compose*.yml
docker-run

# Temporary files
tmp/
temp/
.tmp/

# Package manager files
package-lock.json
yarn.lock

# SSL certificates (mounted as volumes)
ssl/
*.crt
*.key
*.cert

# Analysis and reports
REPO_ANALYSIS/
.serena/
.claude/
.trunk/

# Cache directories
.cache/
.npm/
.yarn/
.bun/